# Supabase — projeto "Observa" (organização My Dashs, região sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://makpagwocsdhwqaevyqm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KMq_VYlVjxB9BNUuXMzafw_3z_A4YVL

# SEGREDO. Não committar. Pegue em:
# Supabase → Project Settings → API Keys → service_role
# Usada só no servidor: as tabelas de assinante têm RLS sem política, então
# nenhuma outra chave consegue lê-las ou escrevê-las.
SUPABASE_SERVICE_ROLE_KEY=

# Envio de e-mail. Faltando qualquer uma das três, a inscrição é gravada mas
# nenhuma mensagem sai, e a interface diz isso em vez de fingir que mandou.

# SEGREDO. Em resend.com → API Keys.
RESEND_API_KEY=

# Remetente. Precisa ser de um domínio verificado em resend.com → Domains.
# Sem domínio verificado, o Resend só entrega para o e-mail da própria conta e
# o único remetente aceito é onboarding@resend.dev — serve para testar, não
# para produção.
OBSERVA_EMAIL_FROM="Observa <avisos@seu-dominio.com.br>"

# Base para o link de confirmação. Precisa ser a URL pública real: é o
# endereço que a pessoa vai clicar no e-mail. Em desenvolvimento, se ficar
# vazia, cai em http://localhost:3000.
OBSERVA_SITE_URL=

# SEGREDO. Protege a rota que envia as notificações (/api/notificacoes/enviar).
# Sem ele a rota recusa todas as chamadas — aberta, qualquer um dispararia
# envio em massa. Na Vercel, o agendador manda este valor sozinho no cabeçalho
# Authorization. Gere com: openssl rand -base64 32
CRON_SECRET=

# SEGREDO. Assina os links de descadastro. Quem o tiver consegue descadastrar
# qualquer pessoa, e nada mais. Trocá-lo invalida todos os links já enviados,
# então escolha uma vez e mantenha. Sem ele, o resumo não é enviado: e-mail
# periódico sem link de saída não sai. Gere com: openssl rand -base64 32
OBSERVA_UNSUBSCRIBE_SECRET=

# Só em desenvolvimento: aponta o envio para um servidor local que registra os
# pedidos, para testar sem mandar e-mail a ninguém. Ignorada em produção.
# OBSERVA_EMAIL_ENDPOINT=http://localhost:4599/emails
